// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  name      String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Blog {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  content     String   @db.Text
  excerpt     String?  @db.Text
  image       String?  @db.VarChar(500)
  category    String?  @db.VarChar(100)
  linkedPage  String   @default("principal") @db.VarChar(50) // "principal", "paris-1", "paris-2", etc.
  readTime    String?  @db.VarChar(50) // "5 min", "10 min", etc.
  author      String?  @db.VarChar(255)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blogs")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  order     Int      @default(0)
  visible   Boolean  @default(true)
  linkedPage String  @default("principal") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model PageMetadata {
  id          String   @id @default(cuid())
  pagePath    String   @unique @db.VarChar(100) // "principal", "paris-1er", "paris-2eme", etc.
  title       String   @db.VarChar(255)
  description String   @db.Text
  keywords    String?  @db.Text
  ogTitle     String?  @db.VarChar(255)
  ogDescription String? @db.Text
  ogImage     String?  @db.VarChar(500)
  twitterTitle String? @db.VarChar(255)
  twitterDescription String? @db.Text
  twitterImage String? @db.VarChar(500)
  canonical  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("page_metadata")
}
